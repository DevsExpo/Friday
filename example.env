# Telegram API credentials: https://my.telegram.org/apps
API_ID=
API_HASH=

# Optional assistant bot credentials (create a bot with @BotFather)
BOT_TOKEN=
BOT_MODE=false
OWNER_ID=

# Optional user account StringSessions (separate multiple sessions with spaces)
SESSIONS=

# Database: sqlite:///friday.db (default, fast, zero-setup), or mongodb+srv://..., postgresql://...
DB_URI=sqlite:///friday.db
DB_NAME=Friday

# Optional settings
CMD_HANDLER=.
SUDO_CMD_HANDLER=!
SUDO_USERS=
UPDATE_ON_STARTUP=false
DEBUG=false

# Extra Plugins Configuration (auto clone, sync, and batch install dependencies)
LOAD_XTRA_PLUGINS=true
XTRA_PLUGINS_REPOS=https://github.com/FridaySoftware/XtraPlugins
